#!/usr/bin/env node
'use strict';
/**
 * claudeagent — voir en direct les assistants Claude Code lancés en tâche de
 * fond depuis le dossier courant.
 *
 *   claudeagent              les agents du projet courant
 *   claudeagent --all        tous projets confondus
 *   claudeagent --once       liste unique, sans TUI (pipeable)
 *
 * Navigation : ↑↓ ou clic pour choisir un agent, son activité récente
 * s'affiche en dessous. q pour quitter.
 *
 * Source des données : Claude Code écrit un transcript JSONL par sous-agent
 * dans ~/.claude/projects/<projet>/<session>/subagents/agent-<id>.jsonl.
 * La première ligne est la mission confiée, les suivantes le déroulé.
 *
 * Zéro dépendance. Le terminal est piloté directement (SGR 1006 pour la
 * souris), comme watchtodo.
 */

const fs = require('fs');
const path = require('path');
const os = require('os');

const PROJETS = path.join(os.homedir(), '.claude', 'projects');
// Au-delà, un agent qui n'a rien écrit est considéré terminé. Un agent actif
// écrit à chaque étape (pensée, appel d'outil, résultat), donc ce silence est
// significatif — mais ce n'est qu'une heuristique, pas un statut officiel.
const SEUIL_ACTIF_MS = 45_000;

const argv = process.argv.slice(2);
const TOUS = argv.includes('--all') || argv.includes('-a');
const UNE_FOIS = argv.includes('--once') || argv.includes('-1');
if (argv.includes('-h') || argv.includes('--help')) {
  const doc = fs.readFileSync(__filename, 'utf8').split('\n');
  const d = doc.indexOf('/**') + 1;
  const f = doc.indexOf(' */');
  console.log(doc.slice(d, f).map((l) => l.replace(/^ \* ?/, '').replace(/^ \*$/, '')).join('\n'));
  process.exit(0);
}

// ── Couleurs ────────────────────────────────────────────────────────────
const E = '\x1b[';
const C = {
  rst: E + '0m', bold: E + '1m', dim: E + '2m',
  red: E + '31m', grn: E + '32m', ylw: E + '33m', cyn: E + '36m',
  gry: E + '90m', bgSel: E + '48;5;238m',
};

function charWidth(cp) {
  if (cp === 0x200d) return 0;
  if (cp >= 0xfe00 && cp <= 0xfe0f) return 0;
  if (cp < 0x1100) return 1;
  if (
    (cp >= 0x1100 && cp <= 0x115f) || (cp >= 0x2e80 && cp <= 0xa4cf) ||
    (cp >= 0xac00 && cp <= 0xd7a3) || (cp >= 0xf900 && cp <= 0xfaff) ||
    (cp >= 0xfe30 && cp <= 0xfe6f) || (cp >= 0xff00 && cp <= 0xff60) ||
    (cp >= 0xffe0 && cp <= 0xffe6) || (cp >= 0x1f300 && cp <= 0x1f64f) ||
    (cp >= 0x1f680 && cp <= 0x1f6ff) || (cp >= 0x1f900 && cp <= 0x1f9ff)
  ) return 2;
  return 1;
}
const dw = (s) => [...s].reduce((n, ch) => n + charWidth(ch.codePointAt(0)), 0);
function trunc(s, max) {
  if (max < 2) return '';
  if (dw(s) <= max) return s;
  let out = '', n = 0;
  for (const ch of s) {
    const w = charWidth(ch.codePointAt(0));
    if (n + w > max - 1) break;
    out += ch; n += w;
  }
  return out + '…';
}

// ── Localisation du projet ──────────────────────────────────────────────
/**
 * Claude Code encode le répertoire de travail dans le nom du dossier projet
 * (`/` → `-`). On remonte l'arborescence : lancer la commande depuis un
 * sous-dossier du dépôt doit marcher.
 */
function dossiersProjet() {
  if (TOUS) {
    try {
      return fs.readdirSync(PROJETS).map((d) => path.join(PROJETS, d));
    } catch { return []; }
  }
  let cur = process.cwd();
  const trouves = [];
  for (;;) {
    const p = path.join(PROJETS, cur.replace(/\//g, '-'));
    if (fs.existsSync(p)) trouves.push(p);
    const parent = path.dirname(cur);
    if (parent === cur) break;
    cur = parent;
  }
  return trouves;
}

/**
 * Le transcript d'un sous-agent ne contient que son prompt, qui commence par
 * du passe-partout — inutilisable comme titre. Le vrai libellé est la
 * `description` passée à l'outil Agent, qui vit dans le transcript de la
 * session PARENTE. On l'y retrouve en deux temps : le bloc `tool_use` porte
 * la description, et le `tool_result` correspondant porte l'`agentId`.
 *
 * Ce fichier fait plusieurs mégaoctets et grossit en continu. On le lit donc
 * une fois, puis seulement les octets ajoutés à chaque rafraîchissement.
 */
const cacheParents = new Map(); // fichier → { taille, descriptions: Map }

function libelles(projet) {
  let fichiers;
  try {
    fichiers = fs
      .readdirSync(projet)
      .filter((n) => n.endsWith('.jsonl'))
      .map((n) => path.join(projet, n));
  } catch { return new Map(); }

  const out = new Map();
  for (const f of fichiers) {
    let cache = cacheParents.get(f);
    if (!cache) {
      cache = { taille: 0, parOutil: new Map(), parAgent: new Map() };
      cacheParents.set(f, cache);
    }
    let taille;
    try { taille = fs.statSync(f).size; } catch { continue; }
    // Fichier tronqué ou remplacé : on repart de zéro.
    if (taille < cache.taille) {
      cache.taille = 0;
      cache.parOutil.clear();
      cache.parAgent.clear();
    }
    if (taille > cache.taille) {
      let txt = '';
      try {
        const fd = fs.openSync(f, 'r');
        try {
          const buf = Buffer.alloc(taille - cache.taille);
          fs.readSync(fd, buf, 0, buf.length, cache.taille);
          txt = buf.toString('utf8');
        } finally { fs.closeSync(fd); }
      } catch { continue; }

      // La dernière ligne peut être incomplète : on s'arrête au dernier \n
      // et on reprendra à partir de là au prochain tour.
      const coupe = txt.lastIndexOf('\n');
      if (coupe < 0) continue;
      cache.taille += Buffer.byteLength(txt.slice(0, coupe + 1), 'utf8');

      for (const ligne of txt.slice(0, coupe).split('\n')) {
        if (!ligne.includes('Agent') && !ligne.includes('agentId')) continue;
        let e;
        try { e = JSON.parse(ligne); } catch { continue; }
        const c = e?.message?.content;
        if (!Array.isArray(c)) continue;
        for (const part of c) {
          if (part.type === 'tool_use' && part.name === 'Agent') {
            cache.parOutil.set(part.id, part.input?.description ?? '');
          } else if (part.type === 'tool_result' && part.tool_use_id) {
            const brut = typeof part.content === 'string'
              ? part.content
              : JSON.stringify(part.content ?? '');
            const m = brut.match(/agentId: ([0-9a-f]{8,})/);
            if (m) cache.parAgent.set(m[1], part.tool_use_id);
          }
        }
      }
    }
    for (const [agentId, outilId] of cache.parAgent) {
      const d = cache.parOutil.get(outilId);
      if (d) out.set(agentId, d);
    }
  }
  return out;
}

function fichiersAgents() {
  const out = [];
  for (const projet of dossiersProjet()) {
    let sessions;
    try { sessions = fs.readdirSync(projet); } catch { continue; }
    for (const s of sessions) {
      const dir = path.join(projet, s, 'subagents');
      let noms;
      try { noms = fs.readdirSync(dir); } catch { continue; }
      for (const n of noms) {
        if (!n.endsWith('.jsonl')) continue;
        const f = path.join(dir, n);
        try {
          out.push({
            f,
            mtime: fs.statSync(f).mtimeMs,
            projet: path.basename(projet),
            racine: projet,
          });
        } catch { /* fichier disparu entre readdir et stat */ }
      }
    }
  }
  return out;
}

// ── Lecture partielle des transcripts ───────────────────────────────────
/** Premières lignes d'un fichier, sans le charger entièrement. */
function tete(f, octets = 65536) {
  const fd = fs.openSync(f, 'r');
  try {
    const buf = Buffer.alloc(octets);
    const lu = fs.readSync(fd, buf, 0, octets, 0);
    return buf.subarray(0, lu).toString('utf8');
  } finally { fs.closeSync(fd); }
}

/** Dernières lignes d'un fichier. Un transcript peut peser plusieurs Mo. */
function queue(f, octets = 262144) {
  const fd = fs.openSync(f, 'r');
  try {
    const taille = fs.fstatSync(fd).size;
    const depart = Math.max(0, taille - octets);
    const buf = Buffer.alloc(Math.min(octets, taille));
    const lu = fs.readSync(fd, buf, 0, buf.length, depart);
    const txt = buf.subarray(0, lu).toString('utf8');
    // Si on n'est pas parti du début, la première ligne est tronquée.
    return depart > 0 ? txt.slice(txt.indexOf('\n') + 1) : txt;
  } finally { fs.closeSync(fd); }
}

function lignesJson(txt) {
  const out = [];
  for (const l of txt.split('\n')) {
    const t = l.trim();
    if (!t) continue;
    try { out.push(JSON.parse(t)); } catch { /* ligne partielle */ }
  }
  return out;
}

/** Première ligne utile d'une sortie d'outil, aplatie. */
function extraitSortie(contenu) {
  const brut =
    typeof contenu === 'string'
      ? contenu
      : Array.isArray(contenu)
        ? contenu.map((p) => p.text ?? '').join('\n')
        : '';
  for (const ligne of brut.split('\n')) {
    const t = ligne.trim();
    if (t) return t;
  }
  return '';
}

/**
 * Résumé lisible d'un évènement du transcript.
 *
 * `kind` sert au filtrage : les blocs `thinking` sont conservés en base mais
 * leur champ `thinking` est TOUJOURS vide — Claude Code n'en persiste que la
 * signature. Une ligne « réflexion » n'apprend donc rien, sauf quand c'est
 * l'évènement le plus récent : elle dit alors que l'agent réfléchit là,
 * maintenant. On ne garde que celle-là.
 */
function evenement(e) {
  const c = e?.message?.content;
  if (typeof c === 'string') {
    return { kind: 'texte', icone: '›', texte: c.replace(/\s+/g, ' ').trim() };
  }
  if (!Array.isArray(c)) return null;
  for (const part of c) {
    if (part.type === 'tool_use') {
      const a = part.input ?? {};
      const detail =
        a.command ?? a.file_path ?? a.pattern ?? a.query ?? a.description ?? '';
      return {
        kind: 'outil',
        icone: '⚙',
        texte: `${part.name}${detail ? ' · ' + String(detail).replace(/\s+/g, ' ') : ''}`,
      };
    }
    if (part.type === 'text' && part.text?.trim()) {
      return { kind: 'texte', icone: '›', texte: part.text.replace(/\s+/g, ' ').trim() };
    }
    if (part.type === 'thinking') {
      return { kind: 'pensee', icone: '·', texte: 'réflexion en cours…' };
    }
    if (part.type === 'tool_result') {
      const sortie = extraitSortie(part.content);
      return {
        kind: 'sortie',
        icone: part.is_error ? '✗' : '↳',
        texte: sortie || (part.is_error ? 'échec' : 'sans sortie'),
      };
    }
  }
  return null;
}

function duree(ms) {
  if (!Number.isFinite(ms) || ms < 0) return '';
  const s = Math.floor(ms / 1000);
  if (s < 60) return `${s}s`;
  const m = Math.floor(s / 60);
  if (m < 60) return `${m}m${String(s % 60).padStart(2, '0')}`;
  return `${Math.floor(m / 60)}h${String(m % 60).padStart(2, '0')}`;
}

function charger() {
  const maintenant = Date.now();
  const agents = [];
  const titres = new Map();
  for (const { f, mtime, projet, racine } of fichiersAgents()) {
    if (!titres.has(racine)) titres.set(racine, libelles(racine));
    let premier, derniers;
    try {
      premier = lignesJson(tete(f))[0];
      derniers = lignesJson(queue(f));
    } catch { continue; }
    if (!premier) continue;

    const id = path.basename(f).replace(/^agent-|\.jsonl$/g, '');
    const titre = titres.get(racine)?.get(id) ?? '';
    const brut = premier.message?.content;
    const mission = (typeof brut === 'string'
      ? brut
      : Array.isArray(brut)
        ? brut.map((p) => p.text ?? '').join(' ')
        : ''
    ).replace(/\s+/g, ' ').trim();

    const debut = Date.parse(premier.timestamp ?? '') || mtime;
    const fin = Date.parse(derniers[derniers.length - 1]?.timestamp ?? '') || mtime;
    const actif = maintenant - mtime < SEUIL_ACTIF_MS;

    const activite = [];
    for (let i = derniers.length - 1; i >= 0 && activite.length < 60; i--) {
      const ev = evenement(derniers[i]);
      if (!ev) continue;
      // Les réflexions ne portent aucun texte : on ne garde que la plus
      // récente, qui signale « l'agent pense en ce moment ».
      if (ev.kind === 'pensee' && activite.length > 0) continue;
      activite.push({ ...ev, ts: Date.parse(derniers[i].timestamp ?? '') || 0 });
    }

    agents.push({
      // Le titre de l'outil quand on l'a, le prompt en repli.
      mission: titre || mission,
      id, projet, actif, mtime, debut,
      duree: fin - debut,
      etapes: derniers.length,
      activite,
    });
  }
  // Actifs en haut, puis tri par date de LANCEMENT décroissante — pas par
  // dernière activité : l'ordre de la liste doit rester stable pendant qu'on
  // la regarde, or la dernière activité change à chaque seconde et ferait
  // sauter les lignes sous le curseur.
  agents.sort((a, b) => (b.actif - a.actif) || (b.debut - a.debut));
  return agents;
}

// ── Mode --once ─────────────────────────────────────────────────────────
if (UNE_FOIS || !process.stdout.isTTY || !process.stdin.isTTY) {
  const agents = charger();
  if (!agents.length) {
    console.log('Aucun agent pour ce projet. `claudeagent --all` pour tout voir.');
    process.exit(0);
  }
  for (const a of agents) {
    const etat = a.actif ? 'ACTIF' : 'fini ';
    console.log(
      `${etat}  ${a.id.slice(0, 9)}  ${duree(a.duree).padStart(6)}  ${a.etapes
        .toString()
        .padStart(4)} étapes  ${a.mission.slice(0, 60)}`,
    );
    if (a.activite[0]) console.log(`         ${a.activite[0].icone} ${a.activite[0].texte.slice(0, 70)}`);
  }
  process.exit(0);
}

// ── TUI ─────────────────────────────────────────────────────────────────
let agents = charger();
let sel = 0;
let offDetail = 0;
let redraw = true;

function entrer() {
  process.stdout.write(E + '?1049h' + E + '?25l' + E + '?1000h' + E + '?1006h');
}
function sortir() {
  process.stdout.write(E + '?1006l' + E + '?1000l' + E + '?25h' + E + '?1049l');
  try { process.stdin.setRawMode(false); } catch {}
}
function quitter(code = 0) { sortir(); process.exit(code); }

entrer();
process.stdin.setRawMode(true);
process.stdin.resume();
process.stdin.setEncoding('utf8');
process.on('exit', sortir);
process.on('SIGINT', () => quitter(0));
process.on('SIGTERM', () => quitter(0));
process.stdout.on('resize', () => { redraw = true; dessiner(); });

// Hauteur de la liste : au plus la moitié de l'écran, et jamais moins de 3.
function hauteurListe(rows) {
  return Math.max(3, Math.min(agents.length + 1, Math.floor((rows - 4) / 2)));
}

function dessiner() {
  const cols = process.stdout.columns || 80;
  const rows = process.stdout.rows || 24;
  const out = [E + 'H'];

  const actifs = agents.filter((a) => a.actif).length;
  const entete =
    `${C.bold}AGENTS${C.rst} ${C.gry}·${C.rst} ` +
    (actifs
      ? `${C.grn}${actifs} actif${actifs > 1 ? 's' : ''}${C.rst}`
      : `${C.gry}aucun actif${C.rst}`) +
    ` ${C.gry}·${C.rst} ${agents.length} au total` +
    (TOUS ? ` ${C.gry}(tous projets)${C.rst}` : '');
  out.push(trunc(entete, cols) + E + 'K');
  out.push(C.gry + '─'.repeat(cols) + C.rst + E + 'K');

  if (!agents.length) {
    out.push(`${C.gry}Aucun agent pour ce projet.${C.rst}` + E + 'K');
    out.push(`${C.gry}Lance \`claudeagent --all\` pour tout voir.${C.rst}` + E + 'K');
    process.stdout.write(out.join('\n') + E + 'J');
    return;
  }

  const hList = hauteurListe(rows);
  const debut = Math.max(0, Math.min(sel - hList + 1, agents.length - hList));
  for (let i = 0; i < hList; i++) {
    const a = agents[debut + i];
    if (!a) { out.push(E + 'K'); continue; }
    const choisi = debut + i === sel;
    const puce = a.actif ? `${C.grn}●${C.rst}` : `${C.gry}✔${C.rst}`;
    const d = duree(a.duree).padStart(6);
    const gauche = ` ${a.actif ? '●' : '✔'} ${a.id.slice(0, 9)} ${d}  `;
    const mission = trunc(a.mission, Math.max(8, cols - dw(gauche)));
    let ligne =
      ` ${puce} ${C.bold}${a.id.slice(0, 9)}${C.rst} ${C.gry}${d}${C.rst}  ` +
      (a.actif ? mission : C.dim + mission + C.rst);
    const pad = ' '.repeat(Math.max(0, cols - dw(gauche) - dw(mission)));
    if (choisi) ligne = C.bgSel + ligne.split(C.rst).join(C.rst + C.bgSel) + pad + C.rst;
    else ligne += pad;
    out.push(ligne + E + 'K');
  }

  out.push(C.gry + '─'.repeat(cols) + C.rst + E + 'K');

  const a = agents[sel];
  const hDetail = rows - hList - 4;
  const lignes = [];
  if (a) {
    lignes.push(`${C.gry}${a.etapes} étapes · ${a.projet}${C.rst}`);
    for (const ev of a.activite) {
      const couleur = ev.icone === '⚙' ? C.cyn : ev.icone === '↳' ? C.gry : C.rst;
      lignes.push(`${couleur}${ev.icone}${C.rst} ${trunc(ev.texte, cols - 3)}`);
    }
  }
  offDetail = Math.max(0, Math.min(offDetail, Math.max(0, lignes.length - hDetail)));
  for (let i = 0; i < hDetail; i++) {
    out.push((lignes[offDetail + i] ?? '') + E + 'K');
  }

  const aide = `${C.gry}↑↓ choisir · clic · PgUp/PgDn détail · r recharger · q quitter${C.rst}`;
  out.push(trunc(aide, cols));
  process.stdout.write(out.join('\n') + E + 'J');
}

function recharger() {
  const idAvant = agents[sel]?.id;
  agents = charger();
  if (idAvant) {
    const i = agents.findIndex((a) => a.id === idAvant);
    if (i >= 0) sel = i;
  }
  if (sel >= agents.length) sel = Math.max(0, agents.length - 1);
}

// Le contenu bouge en permanence : on recharge au rythme d'une seconde, ce
// qui suffit largement à suivre un agent et reste indolore côté disque.
setInterval(() => { recharger(); dessiner(); }, 1000).unref?.();

function bouger(d) {
  if (!agents.length) return;
  sel = Math.max(0, Math.min(agents.length - 1, sel + d));
  offDetail = 0;
}

function clic(y) {
  const hList = hauteurListe(process.stdout.rows || 24);
  const debut = Math.max(0, Math.min(sel - hList + 1, agents.length - hList));
  const i = debut + (y - 3);
  if (i >= 0 && i < agents.length) { sel = i; offDetail = 0; }
}

let buf = '';
process.stdin.on('data', (chunk) => {
  buf += chunk;
  let garde = 0;
  while (buf.length && garde++ < 64) {
    const souris = buf.match(/^\x1b\[<(\d+);(\d+);(\d+)([Mm])/);
    if (souris) {
      buf = buf.slice(souris[0].length);
      const btn = +souris[1], y = +souris[3], presse = souris[4] === 'M';
      if (btn === 64) offDetail = Math.max(0, offDetail - 3);
      else if (btn === 65) offDetail += 3;
      else if (presse && (btn & 3) === 0) clic(y);
      dessiner();
      continue;
    }
    if (/^\x1b\[<\d*;?\d*;?\d*$/.test(buf) || buf === '\x1b' || buf === '\x1b[') break;

    const fleche = buf.match(/^\x1b\[([ABCD])/);
    if (fleche) {
      buf = buf.slice(fleche[0].length);
      if (fleche[1] === 'A') bouger(-1);
      else if (fleche[1] === 'B') bouger(1);
      dessiner();
      continue;
    }
    const page = buf.match(/^\x1b\[([56])~/);
    if (page) {
      buf = buf.slice(page[0].length);
      offDetail = page[1] === '5' ? Math.max(0, offDetail - 10) : offDetail + 10;
      dessiner();
      continue;
    }

    const ch = buf[0];
    buf = buf.slice(1);
    if (ch === 'q' || ch === '\x03') quitter(0);
    else if (ch === 'j') bouger(1);
    else if (ch === 'k') bouger(-1);
    else if (ch === 'r') recharger();
    else continue;
    dessiner();
  }
});

dessiner();
